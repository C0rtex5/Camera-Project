# Copy to .env.production. Use the server's VPN interface IPv4 address.
# Default access: http://localhost:1221
SENTINEL_BIND_ADDRESS=127.0.0.1
SENTINEL_PORT=1221
# Must match the exact URL opened in the browser, without trailing slash.
SENTINEL_ORIGIN=http://localhost:1221
SENTINEL_DEVICE=auto
SENTINEL_RETENTION_DAYS=7
SENTINEL_EVIDENCE_MAX_BYTES=2147483648
SENTINEL_ENABLE_DEMO=false
