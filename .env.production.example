# Copy to .env.production; keep camera credentials private.
# Optional legacy camera source; prefer the Camera setup panel.
CAMERA_GATE_RTSP=
# Optional agent provider; camera monitoring does not require a cloud account.
# OPENAI_API_KEY=
# SENTINEL_LLM_MODEL=
# Optional SSH camera tunnel, for local execution. Docker: use compose.ssh.yaml.
# SENTINEL_SSH_KEY_FILE=/private/path/id_ed25519
# SENTINEL_SSH_KNOWN_HOSTS=/private/path/known_hosts
