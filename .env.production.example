# Copy to .env.production. Listen on all IPv4 interfaces.
# Default access: http://localhost:1221
SENTINEL_BIND_ADDRESS=0.0.0.0
SENTINEL_PORT=1221
# auto accepts same-origin requests through localhost or the server IP.
# An explicit http(s) origin restricts access to that exact browser origin.
SENTINEL_ORIGIN=auto
SENTINEL_DEVICE=auto
# auto selects a compatible GPU; cpu forces CPU.
SENTINEL_ACCELERATOR=auto
# auto prefers a dedicated GPU. A numeric index selects one visible device.
SENTINEL_GPU_INDEX=auto
SENTINEL_RETENTION_DAYS=7
SENTINEL_EVIDENCE_MAX_BYTES=2147483648
SENTINEL_ENABLE_DEMO=false
