ARG BASE_IMAGE=sentinelzone-ai:sec01-candidate
FROM ${BASE_IMAGE}

# Media-complete variant: bakes the restored original repository assets
# (data/real_videos, data/test_videos, and the YOLO datasets) into the image.
#
# The default Dockerfile intentionally keeps the runtime image slim by ignoring
# data/, so this variant is built from an explicit tar context that contains the
# verified assets. Build it with scripts/build_demo_media_image.sh.
USER root
COPY --chown=10001:10001 data /opt/sentinelzone/data
# Detector weights for the calibrated overlay drawn on restored recordings.
# This is the small COCO yolov8n model; a production deployment overrides it with
# SENTINEL_DETECTOR_WEIGHTS pointing at a site-trained detector.
COPY --chown=10001:10001 models/detector.pt /opt/sentinelzone/yolov8n.pt
USER sentinel
